# Copy to .env (git-ignored). Both keys are required for `make demo` / `make eval`.
GOOGLE_API_KEY=          # Gemini via google-genai (AI Studio key)
ANTHROPIC_API_KEY=       # Claude via anthropic SDK

# Optional: route Gemini through Vertex AI instead of AI Studio (same code path).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=signal-intel-prod
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional overrides (defaults live in config/models.yaml)
# CG_MODEL_GEMINI=gemini-3.8-flash
# CG_MODEL_CLAUDE=claude-opus-5
# CG_MODEL_TRIAGE=claude-opus-5
