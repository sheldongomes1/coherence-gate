{#- Note term sheet — house style from the approved G12_bversa10.html. One template, four
    layout variants (p.layout): "clauses" (approved), "table", "letter", "prose". -#}
<!doctype html>
<html><head><meta charset="utf-8"><style>
@page { size: letter; margin: 22mm 20mm 20mm 20mm;
  @bottom-left { content: "{{ issuer }} — {{ programme }}"; font: 7pt Helvetica, Arial, sans-serif; color:#777; }
  @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 7pt Helvetica, Arial, sans-serif; color:#777; } }
body { font: 9.5pt/1.42 Georgia, "Times New Roman", serif; color:#111; }
.bar { border-top: 3px solid {{ accent }}; border-bottom: 1px solid {{ accent }}; padding: 6px 0 8px; margin-bottom: 14px; }
.issuer { font: bold 13pt Helvetica, Arial, sans-serif; color:{{ accent }}; letter-spacing: .3px; }
.prog { font: 8pt Helvetica, Arial, sans-serif; color:#555; margin-top: 2px; }
.doctitle { font: bold 11.5pt Helvetica, Arial, sans-serif; margin: 10px 0 1px; }
.docsub { font: 9pt Helvetica, Arial, sans-serif; color:#333; }
h2 { font: bold 10pt Helvetica, Arial, sans-serif; color:{{ accent }}; margin: 13px 0 5px; border-bottom:.6pt solid #c9c4b8; padding-bottom:2px; }
p { margin: 4px 0; text-align: justify; }
table.terms { width:100%; border-collapse: collapse; margin: 6px 0; font-size: 9pt; }
table.terms td { border: .5pt solid #c9c4b8; padding: 3.5px 7px; vertical-align: top; }
table.terms td.k { width: 34%; background:#f4f2ec; font-family: Helvetica, Arial, sans-serif; font-size: 8.4pt; font-weight: bold; color:#333; }
.small { font-size: 7.6pt; color:#444; text-align: justify; }
.rf { font-size: 8.2pt; text-align: justify; color:#222; }
.letter p.addr { text-align:left; margin: 2px 0; }
</style></head><body>

<div class="bar">
  <div class="issuer">{{ issuer|upper }}</div>
  <div class="prog">{{ programme }} &nbsp;·&nbsp; {{ desk }}</div>
</div>

{% macro underlying_section(num) -%}
<h2>{{ num }}. The Underlying Index</h2>
{% if index %}
<p>The Underlying is a rules-based, volatility-targeting index administered by Bloomberg Index Services Limited ("BISL") and calculated in accordance with the Bloomberg Versa Indices Methodology dated 21 March 2025 (the "Index Methodology"), as supplemented by the index-specific document for the Underlying. The parameters below summarise the index-specific terms relevant to the Notes; in the event of any inconsistency, the Index Methodology and the index-specific document prevail.</p>
<table class="terms">
  <tr><td class="k">Index / Ticker</td><td>{{ index.name }} — {{ index.ticker }} Index</td></tr>
  <tr><td class="k">Index Administrator</td><td>{{ index.administrator }}</td></tr>
  <tr><td class="k">Return Treatment</td><td>{{ index.return_treatment }}</td></tr>
  <tr><td class="k">Volatility Target</td><td>{{ index.vol_target }}</td></tr>
  <tr><td class="k">Volatility Calculation</td><td>{{ index.vol_calc }}</td></tr>
  <tr><td class="k">Exposure</td><td>{{ index.exposure }}</td></tr>
  <tr><td class="k">Determination Lag</td><td>{{ index.determination_lag }}</td></tr>
  <tr><td class="k">Rebalancing</td><td>{{ index.rebalancing }}</td></tr>
  <tr><td class="k">Deduction Factor</td><td>{{ index.deduction }}</td></tr>
  <tr><td class="k">Transaction Cost Rate</td><td>{{ index.tcr }}</td></tr>
  <tr><td class="k">Index Currency</td><td>{{ index.currency }}</td></tr>
</table>
<p class="small">The Index Value is floored at zero; if the Index Value reaches zero it will remain at zero. Market disruptions affecting the Underlying are addressed in accordance with the Index Methodology and the BISL Benchmark Procedures Handbook.</p>
{% else %}
<p>{{ underlying_prose }} The Initial Level of each Underlying is {{ initial_level }} of its official closing level on the Trade Date, as published by the relevant index sponsor. Index Adjustment Events, Index Disruption Events and successor-index provisions apply as set out in the Base Prospectus.</p>
{% endif %}
{%- endmacro %}

{% macro key_terms_table() -%}
<table class="terms">
  <tr><td class="k">Trade Reference</td><td>{{ trade_id }}</td></tr>
  <tr><td class="k">Issuer</td><td>{{ issuer }}</td></tr>
  <tr><td class="k">Notional Amount</td><td>{{ notional }}</td></tr>
  <tr><td class="k">Currency</td><td>{{ currency }}</td></tr>
  <tr><td class="k">Trade Date</td><td>{{ trade_date }}</td></tr>
  <tr><td class="k">Issue Date</td><td>{{ issue_date }}</td></tr>
  <tr><td class="k">Maturity Date</td><td>{{ maturity_date }}</td></tr>
  <tr><td class="k">Underlying(s)</td><td>{{ underlyings_short }}</td></tr>
  <tr><td class="k">Initial Level</td><td>{{ initial_level }} of the official closing level on the Trade Date</td></tr>
  <tr><td class="k">Coupon</td><td>{{ coupon_phrase }}</td></tr>
  <tr><td class="k">Coupon Frequency</td><td>{{ coupon_frequency_word }}</td></tr>
  <tr><td class="k">Coupon Memory</td><td>{{ 'Applicable' if coupon_memory else 'Not applicable' }}</td></tr>
  {% if coupon_barrier %}<tr><td class="k">Coupon Barrier</td><td>{{ coupon_barrier }} of the Initial Level</td></tr>{% endif %}
  <tr><td class="k">Day Count Fraction</td><td>{{ day_count_word }}</td></tr>
  <tr><td class="k">Autocall Observation Dates</td><td>{{ autocall_dates_text }}</td></tr>
  <tr><td class="k">Autocall Level</td><td>{{ autocall_level_text }}</td></tr>
  <tr><td class="k">Knock-in Type</td><td>{{ knockin_type_text }}</td></tr>
  {% if knockin_level_row %}<tr><td class="k">Knock-in Level</td><td>{{ knockin_level_row }}</td></tr>{% endif %}
  <tr><td class="k">Settlement</td><td>{{ settlement_word }}</td></tr>
  <tr><td class="k">Business Day Convention</td><td>{{ bdc_word }}</td></tr>
  <tr><td class="k">Business Days</td><td>Toronto, New York and London</td></tr>
  <tr><td class="k">Calculation Agent</td><td>The Issuer</td></tr>
  <tr><td class="k">Governing Law</td><td>Ontario</td></tr>
</table>
{%- endmacro %}

{% set boiler_fees %}The Issue Price of 100% includes distribution fees of up to {{ dist_fee }} of the Notional Amount payable to the distributor. The Issuer's estimated hedging costs are {{ hedge_cost }} per annum. These amounts are not Coupons and are not payable to Noteholders. Calculation Agent: the Issuer. Governing law: Ontario. Minimum denomination: {{ currency }} 10,000.{% endset %}
{% set boiler_risk %}An investment in the Notes involves significant risks. Investors may lose some or all of their investment. The Notes are unsecured obligations of the Issuer and are subject to the credit risk of the Issuer. {% if index %}The Underlying employs a volatility-targeting mechanism which may materially reduce exposure to its underlying index in periods of elevated volatility, including in rising markets, and the Deduction Factor and Transaction Cost Rate reduce the Index Value on an ongoing basis; as an Excess Return index, the Underlying does not benefit from any cash or reinvestment return. {% endif %}Past performance, including back-tested performance, of the Underlying is not a reliable indicator of future performance. The secondary market, if any, may be illiquid; a bid price, where available, may be up to 3.00% below the theoretical value of the Notes. A 10% decline in the Underlying does not translate into a 10% decline in the value of the Notes; the relationship is non-linear.{% if coupon_memory %} The memory feature does not guarantee that any deferred Coupon will ultimately be paid.{% endif %}{% endset %}
{% set boiler_legal %}This document is an indicative term sheet and does not constitute an offer, solicitation or recommendation. The Notes will be issued under the Issuer's {{ programme }} and are subject to the Base Prospectus and the applicable Final Terms; in the event of inconsistency between this term sheet and the Final Terms, the Final Terms prevail. {% if index %}"Bloomberg®" and the Bloomberg Versa Indices are trademarks or service marks of Bloomberg Finance L.P. BISL does not sponsor, endorse or guarantee the Notes. {% endif %}Not for distribution in the United States or to U.S. persons. {{ issuer }} is a fictitious entity; this is a synthetic specimen document prepared for systems demonstration purposes.{% endset %}

{% if layout == "clauses" %}
<div class="doctitle">INDICATIVE TERM SHEET</div>
<div class="docsub">{{ product_title }} &nbsp;·&nbsp; Reference {{ trade_id }} &nbsp;·&nbsp; Dated {{ trade_date }}</div>
<h2>1. Summary of the Transaction</h2>
<p>{{ issuer }} (the "Issuer") will issue notes (the "Notes") with reference {{ trade_id }} in an aggregate Notional Amount of {{ notional }}. The Notes are linked to the performance of {{ underlying_phrase }}. The Trade Date is {{ trade_date }}, the Issue Date is {{ issue_date }} and the Scheduled Maturity Date is {{ maturity_date }}, in each case subject to the Business Day Convention set out below. The Initial Level of the Underlying is {{ initial_level }} of its official closing level on the Trade Date{% if index %}, as published by the Index Administrator{% endif %}.</p>
{{ underlying_section(2) }}
<h2>3. Coupon</h2>
<p>{{ coupon_clause }} {{ memory_clause }}</p>
<h2>4. Automatic Early Redemption and Barrier</h2>
<p>{{ autocall_clause }}</p>
<p>{{ barrier_clause }}</p>
<h2>5. Settlement</h2>
<p>Settlement at maturity or upon automatic early redemption is in {{ settlement_word|lower }}, in {{ currency }}. Payment dates are adjusted in accordance with the {{ bdc_word }} Business Day Convention. Business Days: Toronto, New York and London.{% if final_valuation_date %} Final Valuation Date: {{ final_valuation_date }}.{% endif %}</p>
<h2>6. Fees and Other Terms</h2>
<p>{{ boiler_fees }}</p>

{% elif layout == "table" %}
<div class="doctitle">FINAL TERMS SUMMARY</div>
<div class="docsub">{{ product_title }} &nbsp;·&nbsp; {{ trade_id }} &nbsp;·&nbsp; {{ trade_date }}</div>
<h2>1. Key Terms</h2>
{{ key_terms_table() }}
{{ underlying_section(2) }}
<h2>3. Notes to the Key Terms</h2>
<p>{{ memory_clause }}</p>
<p>{{ barrier_clause }}</p>
<p>{{ autocall_clause }}</p>
<h2>4. Fees and Other Terms</h2>
<p>{{ boiler_fees }}</p>

{% elif layout == "letter" %}
<div class="letter">
<p class="addr">{{ desk }}<br>Toronto</p>
<p class="addr">{{ trade_date }}</p>
<p class="addr">Dear Client,</p>
<p><b>Re: {{ trade_id }} — {{ product_title }}</b></p>
<p>Further to our conversation, we are pleased to confirm the indicative terms of the above transaction. {{ issuer }} will issue Notes in a total Notional Amount of {{ notional }} under its {{ programme }}. The Notes were traded on {{ trade_date }}, will be issued on {{ issue_date }} and mature on {{ maturity_date }}. The Notes are linked to {{ underlying_phrase }}.</p>
<p>{{ coupon_clause }} {{ memory_clause }}</p>
<p>{{ autocall_clause }}</p>
<p>{{ barrier_clause }}</p>
<p>All payments are made in {{ currency }} by {{ settlement_word|lower }} settlement and payment dates follow the {{ bdc_word }} convention (Toronto, New York and London business days).{% if final_valuation_date %} The Final Valuation Date is {{ final_valuation_date }}.{% endif %}</p>
<p>Please review the Annex and revert with any comments before we proceed to booking.</p>
<p class="addr">Kind regards,<br>Structured Products Desk</p>
</div>
<h2>Annex A — Key Terms</h2>
{{ key_terms_table() }}
{{ underlying_section("Annex B") }}
<h2>Annex C — Fees and Other Terms</h2>
<p>{{ boiler_fees }}</p>

{% else %}{# prose #}
<div class="doctitle">INDICATIVE TERM SHEET</div>
<div class="docsub">{{ product_title }} &nbsp;·&nbsp; Reference {{ trade_id }} &nbsp;·&nbsp; Dated {{ trade_date }}</div>
<h2>1. The Transaction</h2>
<p>{{ issuer }} (the "Issuer") will issue notes (the "Notes") with reference {{ trade_id }} in an aggregate Notional Amount of {{ notional }}, linked to the performance of {{ underlying_phrase }}. The Trade Date is {{ trade_date }}; the Issue Date is {{ issue_date }}; the Scheduled Maturity Date is {{ maturity_date }}, subject to adjustment in accordance with the {{ bdc_word }} Business Day Convention (Business Days: Toronto, New York and London). The Initial Level of each Underlying is {{ initial_level }} of its official closing level on the Trade Date.</p>
<h2>2. Coupon</h2>
<p>{{ coupon_clause }} {{ memory_clause }}</p>
<h2>3. Automatic Early Redemption</h2>
<p>{{ autocall_clause }}</p>
<h2>4. Knock-in</h2>
<p>{{ barrier_clause }}</p>
<h2>5. Settlement</h2>
<p>{{ settlement_word }} settlement in {{ currency }}.{% if final_valuation_date %} Final Valuation Date: {{ final_valuation_date }}.{% endif %}</p>
{{ underlying_section(6) }}
<h2>7. Summary of Dates and Levels</h2>
<table class="terms">
  <tr><td class="k">Trade / Issue / Maturity</td><td>{{ trade_date }} / {{ issue_date }} / {{ maturity_date }}</td></tr>
  <tr><td class="k">Autocall Observation Dates</td><td>{{ autocall_dates_text }}</td></tr>
  <tr><td class="k">Autocall Level</td><td>{{ autocall_level_text }}</td></tr>
  <tr><td class="k">Knock-in</td><td>{{ knockin_type_text }}{% if knockin_level_row %}; {{ knockin_level_row }}{% endif %}</td></tr>
  <tr><td class="k">Day Count</td><td>{{ day_count_word }}</td></tr>
</table>
<h2>8. Fees and Other Terms</h2>
<p>{{ boiler_fees }}</p>
{% endif %}

<h2>Risk Factors (Summary)</h2>
<p class="rf">{{ boiler_risk }}</p>
<p class="small">{{ boiler_legal }}</p>
</body></html>
