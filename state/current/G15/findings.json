  {
    "id": "G15:rel:premium_arithmetic",
    "doc_id": "G15",
    "field": "rel:premium_arithmetic",
    "type": "RELATION_VIOLATION",
    "severity": "critical",
    "ts_value": "1037500",
    "booking_value": "830000",
    "citations": [],
    "detail": "violated on booking \u2014 premium_arithmetic: term sheet [4.15\u00d70.01 \u00d7 25000000 = 1.0375E+6 vs premium_amount 1.0375E+6]; booking [4.15\u00d70.01 \u00d7 25000000 = 1.0375E+6 vs premium_amount 8.3E+5]",
    "lane": "TRIAGE",
    "triage": {
      "classification": "BOOKING_LIKELY_WRONG",
      "desk_query": "On G15 the term sheet's premium terms are internally consistent: 4.15% \u00d7 USD 25,000,000 = USD 1,037,500, which matches the stated premium amount. The booking record carries premium_amount of USD 830,000 against the same 4.15% rate and USD 25,000,000 notional, so the booked premium fails the rate \u00d7 notional arithmetic by USD 207,500 (booked figure implies a 3.32% rate). Please confirm whether the booking premium_amount should be corrected to USD 1,037,500, or whether a different rate or notional was agreed and needs to be re-papered.",
      "cited_clause": "",
      "booking_field": "rel:premium_arithmetic",
      "booking_value": "830000",
      "rationale": "The arithmetic holds on the term sheet and fails only on the booking, so the defect sits in the booked premium amount rather than the document."
    }
