    ],
    "detail": "TS 1037500 \u2260 booking 830000",
    "lane": "TRIAGE",
    "triage": {
      "classification": "BOOKING_LIKELY_WRONG",
      "desk_query": "Term sheet G15 states: \"Premium 4.15% of the Notional Amount (USD 1,037,500)\", i.e. USD 1,037,500 on a notional of USD 25,000,000. The booking record field \"premium_amount\" holds 830,000, which is 4.15% of a USD 20,000,000 notional, suggesting the trade was booked against a different notional than the one printed. Please confirm the executed notional and correct the booked premium to USD 1,037,500, or provide the amended term sheet if the USD 20,000,000 notional is the correct trade economics.",
      "cited_clause": "Premium 4.15% of the Notional Amount (USD 1,037,500)",
      "booking_field": "premium_amount",
      "booking_value": "830000",
      "rationale": "Both extractors agree on an internally consistent term sheet figure (4.15% \u00d7 USD 25,000,000 = USD 1,037,500), while the booked amount matches the same rate applied to a smaller notional, pointing to a booking-side error rather than a document defect."
    }
